[
  {
    "segment_id": "s-00001",
    "start_seconds": 3,
    "end_seconds": 5,
    "text": "안녕하세요 여러분. 제 이름"
  },
  {
    "segment_id": "s-00002",
    "start_seconds": 5,
    "end_seconds": 6,
    "text": "은 패트릭 니콜 레티스"
  },
  {
    "segment_id": "s-00003",
    "start_seconds": 6,
    "end_seconds": 8,
    "text": "입니다. 저는 GitHub Copilot 팀의"
  },
  {
    "segment_id": "s-00004",
    "start_seconds": 8,
    "end_seconds": 10,
    "text": "제품 관리자 입니다. 저는"
  },
  {
    "segment_id": "s-00005",
    "start_seconds": 10,
    "end_seconds": 12,
    "text": "특히 Copilot SDK와 런타임을"
  },
  {
    "segment_id": "s-00006",
    "start_seconds": 12,
    "end_seconds": 14,
    "text": "담당 하고 있으며, 이 새로운"
  },
  {
    "segment_id": "s-00007",
    "start_seconds": 14,
    "end_seconds": 16,
    "text": "시대로 나아가는 과정에서"
  },
  {
    "segment_id": "s-00008",
    "start_seconds": 16,
    "end_seconds": 18,
    "text": "에이전트가 앞으로 갖춰야 할"
  },
  {
    "segment_id": "s-00009",
    "start_seconds": 18,
    "end_seconds": 19,
    "text": "다양한 요구 사항과 작업을"
  },
  {
    "segment_id": "s-00010",
    "start_seconds": 19,
    "end_seconds": 21,
    "text": "여러 환경에서 수행 할 수"
  },
  {
    "segment_id": "s-00011",
    "start_seconds": 21,
    "end_seconds": 24,
    "text": "있도록 지원 하고 있습니다."
  },
  {
    "segment_id": "s-00012",
    "start_seconds": 24,
    "end_seconds": 26,
    "text": "핵심 주제 인 에이전트"
  },
  {
    "segment_id": "s-00013",
    "start_seconds": 26,
    "end_seconds": 28,
    "text": "호스트 프로토콜로 넘어 가기"
  },
  {
    "segment_id": "s-00014",
    "start_seconds": 28,
    "end_seconds": 30,
    "text": "전에, Copilot SDK와 에이전트"
  },
  {
    "segment_id": "s-00015",
    "start_seconds": 30,
    "end_seconds": 31,
    "text": "호스트 프로토콜의 관계,"
  },
  {
    "segment_id": "s-00016",
    "start_seconds": 31,
    "end_seconds": 33,
    "text": "그리고 GitHub에서 진행 중인"
  },
  {
    "segment_id": "s-00017",
    "start_seconds": 33,
    "end_seconds": 35,
    "text": "투자와 앞으로 몇 달 내에"
  },
  {
    "segment_id": "s-00018",
    "start_seconds": 35,
    "end_seconds": 37,
    "text": "선보일 흥미로운 신기능들에"
  },
  {
    "segment_id": "s-00019",
    "start_seconds": 37,
    "end_seconds": 38,
    "text": "대해 간략히 말씀"
  },
  {
    "segment_id": "s-00020",
    "start_seconds": 38,
    "end_seconds": 42,
    "text": "드리겠습니다. GitHub Copilot SDK"
  },
  {
    "segment_id": "s-00021",
    "start_seconds": 42,
    "end_seconds": 44,
    "text": "는 에이전트를 위한 최첨단"
  },
  {
    "segment_id": "s-00022",
    "start_seconds": 44,
    "end_seconds": 46,
    "text": "최신 런타임 입니다. 현재"
  },
  {
    "segment_id": "s-00023",
    "start_seconds": 46,
    "end_seconds": 47,
    "text": "GitHub 내부에서 사용되고"
  },
  {
    "segment_id": "s-00024",
    "start_seconds": 47,
    "end_seconds": 49,
    "text": "있습니다. 또한 Office 제품군"
  },
  {
    "segment_id": "s-00025",
    "start_seconds": 49,
    "end_seconds": 50,
    "text": "과 같은 Microsoft 전반에서"
  },
  {
    "segment_id": "s-00026",
    "start_seconds": 50,
    "end_seconds": 52,
    "text": "사용 되며, 해당 서비스들에"
  },
  {
    "segment_id": "s-00027",
    "start_seconds": 52,
    "end_seconds": 53,
    "text": "존재 하는 새로운 에이전트"
  },
  {
    "segment_id": "s-00028",
    "start_seconds": 53,
    "end_seconds": 55,
    "text": "모드 기능을 구동 합니다."
  },
  {
    "segment_id": "s-00029",
    "start_seconds": 55,
    "end_seconds": 56,
    "text": "런타임 자체를 생각해 보면,"
  },
  {
    "segment_id": "s-00030",
    "start_seconds": 56,
    "end_seconds": 58,
    "text": "이 기술은 매우 높은 이식성"
  },
  {
    "segment_id": "s-00031",
    "start_seconds": 58,
    "end_seconds": 60,
    "text": "을 자랑 합니다. 다양한 환경"
  },
  {
    "segment_id": "s-00032",
    "start_seconds": 60,
    "end_seconds": 61,
    "text": "에서 실행 되도록 설계"
  },
  {
    "segment_id": "s-00033",
    "start_seconds": 61,
    "end_seconds": 63,
    "text": "되었으며, 그에 따른 여러"
  },
  {
    "segment_id": "s-00034",
    "start_seconds": 63,
    "end_seconds": 64,
    "text": "제약 조건도 유연 하게 적용"
  },
  {
    "segment_id": "s-00035",
    "start_seconds": 64,
    "end_seconds": 67,
    "text": "할 수 있습니다. 기본 설정"
  },
  {
    "segment_id": "s-00036",
    "start_seconds": 67,
    "end_seconds": 69,
    "text": "가이드만 봐도 현재이 런타임"
  },
  {
    "segment_id": "s-00037",
    "start_seconds": 69,
    "end_seconds": 71,
    "text": "을 적용 할 수 있는 환경이"
  },
  {
    "segment_id": "s-00038",
    "start_seconds": 71,
    "end_seconds": 72,
    "text": "얼마나 다양한 지 알 수"
  },
  {
    "segment_id": "s-00039",
    "start_seconds": 72,
    "end_seconds": 74,
    "text": "있으며, 그 이후에 어떤"
  },
  {
    "segment_id": "s-00040",
    "start_seconds": 74,
    "end_seconds": 75,
    "text": "추가적인 문제 들이 발생"
  },
  {
    "segment_id": "s-00041",
    "start_seconds": 75,
    "end_seconds": 77,
    "text": "하는 지도 확인할 수"
  },
  {
    "segment_id": "s-00042",
    "start_seconds": 77,
    "end_seconds": 79,
    "text": "있습니다. 이 런타임은 개인"
  },
  {
    "segment_id": "s-00043",
    "start_seconds": 79,
    "end_seconds": 81,
    "text": "생산성 애플리케이션으로"
  },
  {
    "segment_id": "s-00044",
    "start_seconds": 81,
    "end_seconds": 82,
    "text": "로컬 컴퓨터에 설치할 수도"
  },
  {
    "segment_id": "s-00045",
    "start_seconds": 82,
    "end_seconds": 84,
    "text": "있고, 클라우드의 관리 형"
  },
  {
    "segment_id": "s-00046",
    "start_seconds": 84,
    "end_seconds": 85,
    "text": "서비스로 호스팅 할 수도"
  },
  {
    "segment_id": "s-00047",
    "start_seconds": 85,
    "end_seconds": 87,
    "text": "있으며, 다른 애플리케이션"
  },
  {
    "segment_id": "s-00048",
    "start_seconds": 87,
    "end_seconds": 88,
    "text": "내에서 프로세스 형태로"
  },
  {
    "segment_id": "s-00049",
    "start_seconds": 88,
    "end_seconds": 90,
    "text": "실행할 수도 있습니다. 최근"
  },
  {
    "segment_id": "s-00050",
    "start_seconds": 90,
    "end_seconds": 92,
    "text": "에는 런타임을 개선 하여 더"
  },
  {
    "segment_id": "s-00051",
    "start_seconds": 92,
    "end_seconds": 93,
    "text": "많은 플랫폼에 내장 하고"
  },
  {
    "segment_id": "s-00052",
    "start_seconds": 93,
    "end_seconds": 95,
    "text": "실행할 수 있도록 지원 범위"
  },
  {
    "segment_id": "s-00053",
    "start_seconds": 95,
    "end_seconds": 98,
    "text": "를 넓혔 습니다. 에이전트"
  },
  {
    "segment_id": "s-00054",
    "start_seconds": 98,
    "end_seconds": 99,
    "text": "호스트 프로토콜은 런타임"
  },
  {
    "segment_id": "s-00055",
    "start_seconds": 99,
    "end_seconds": 101,
    "text": "기능과 사용자가 어디 서든"
  },
  {
    "segment_id": "s-00056",
    "start_seconds": 101,
    "end_seconds": 103,
    "text": "해당 런타임에 접근 할 수"
  },
  {
    "segment_id": "s-00057",
    "start_seconds": 103,
    "end_seconds": 105,
    "text": "있게 해주는 중요한 접점에"
  },
  {
    "segment_id": "s-00058",
    "start_seconds": 105,
    "end_seconds": 107,
    "text": "위치 합니다. 네, 좋습니다."
  },
  {
    "segment_id": "s-00059",
    "start_seconds": 107,
    "end_seconds": 109,
    "text": "올해 초부터 저희 팀이 열정"
  },
  {
    "segment_id": "s-00060",
    "start_seconds": 109,
    "end_seconds": 111,
    "text": "을 가지고 개발해 온 '"
  },
  {
    "segment_id": "s-00061",
    "start_seconds": 111,
    "end_seconds": 112,
    "text": "에이전트 호스트 프로토콜'"
  },
  {
    "segment_id": "s-00062",
    "start_seconds": 112,
    "end_seconds": 114,
    "text": "은 GitHub Copilot 런타임 뿐만"
  },
  {
    "segment_id": "s-00063",
    "start_seconds": 114,
    "end_seconds": 116,
    "text": "아니라 시장에 나와 있는"
  },
  {
    "segment_id": "s-00064",
    "start_seconds": 116,
    "end_seconds": 117,
    "text": "다른 런타임 이나 모든"
  },
  {
    "segment_id": "s-00065",
    "start_seconds": 117,
    "end_seconds": 119,
    "text": "에이전트 기반 애플리케이션"
  },
  {
    "segment_id": "s-00066",
    "start_seconds": 119,
    "end_seconds": 121,
    "text": "에 적용 할 수 있는 프로토콜"
  },
  {
    "segment_id": "s-00067",
    "start_seconds": 121,
    "end_seconds": 124,
    "text": "정의 입니다. 이 프로토콜의"
  },
  {
    "segment_id": "s-00068",
    "start_seconds": 124,
    "end_seconds": 126,
    "text": "핵심 목표는 사용자가 어디에"
  },
  {
    "segment_id": "s-00069",
    "start_seconds": 126,
    "end_seconds": 128,
    "text": "있든 그 환경에 맞추는 것"
  },
  {
    "segment_id": "s-00070",
    "start_seconds": 128,
    "end_seconds": 130,
    "text": "입니다. 사용 하는 호스트가"
  },
  {
    "segment_id": "s-00071",
    "start_seconds": 130,
    "end_seconds": 132,
    "text": "때에 따라 서로 다른 런타임"
  },
  {
    "segment_id": "s-00072",
    "start_seconds": 132,
    "end_seconds": 134,
    "text": "을 실행 하더라도, 그 호스트"
  },
  {
    "segment_id": "s-00073",
    "start_seconds": 134,
    "end_seconds": 135,
    "text": "에 접근 할 수 있는 방법은 그"
  },
  {
    "segment_id": "s-00074",
    "start_seconds": 135,
    "end_seconds": 137,
    "text": "어느 때보 다 다양해"
  },
  {
    "segment_id": "s-00075",
    "start_seconds": 137,
    "end_seconds": 138,
    "text": "졌습니다. 이제는 노트북,"
  },
  {
    "segment_id": "s-00076",
    "start_seconds": 138,
    "end_seconds": 140,
    "text": "휴대폰 등 다양한 기기를"
  },
  {
    "segment_id": "s-00077",
    "start_seconds": 140,
    "end_seconds": 142,
    "text": "사용 하니까요. 가끔 우리는"
  },
  {
    "segment_id": "s-00078",
    "start_seconds": 142,
    "end_seconds": 143,
    "text": "어제 본 듀오와 같은 새로운"
  },
  {
    "segment_id": "s-00079",
    "start_seconds": 143,
    "end_seconds": 145,
    "text": "폼 팩터를 접하게 됩니다."
  },
  {
    "segment_id": "s-00080",
    "start_seconds": 145,
    "end_seconds": 147,
    "text": "저는 우리가 에이전트가 말"
  },
  {
    "segment_id": "s-00081",
    "start_seconds": 147,
    "end_seconds": 148,
    "text": "그대로 어디 서든 실행될 수"
  },
  {
    "segment_id": "s-00082",
    "start_seconds": 148,
    "end_seconds": 150,
    "text": "있는 세상을 준비 하고"
  },
  {
    "segment_id": "s-00083",
    "start_seconds": 150,
    "end_seconds": 151,
    "text": "있다고 생각 합니다."
  },
  {
    "segment_id": "s-00084",
    "start_seconds": 151,
    "end_seconds": 153,
    "text": "에이전트를 여러 위치로 이동"
  },
  {
    "segment_id": "s-00085",
    "start_seconds": 153,
    "end_seconds": 154,
    "text": "시킬 수 있으며, 더 중요한 점"
  },
  {
    "segment_id": "s-00086",
    "start_seconds": 154,
    "end_seconds": 156,
    "text": "은 어떤 폼 팩터 나 기기를"
  },
  {
    "segment_id": "s-00087",
    "start_seconds": 156,
    "end_seconds": 158,
    "text": "사용 하든 해당 에이전트에"
  },
  {
    "segment_id": "s-00088",
    "start_seconds": 158,
    "end_seconds": 160,
    "text": "접근 할 수 있다는 것 입니다."
  },
  {
    "segment_id": "s-00089",
    "start_seconds": 160,
    "end_seconds": 162,
    "text": "그래서 우리는 이러한 기능을"
  },
  {
    "segment_id": "s-00090",
    "start_seconds": 162,
    "end_seconds": 164,
    "text": "VS Code 나 GitHub Copilot 런타임,"
  },
  {
    "segment_id": "s-00091",
    "start_seconds": 164,
    "end_seconds": 166,
    "text": "그리고 다른 개발자 서비스들"
  },
  {
    "segment_id": "s-00092",
    "start_seconds": 166,
    "end_seconds": 168,
    "text": "로 계속 가져 오고 있습니다."
  },
  {
    "segment_id": "s-00093",
    "start_seconds": 168,
    "end_seconds": 170,
    "text": "우리가 이미 나아가고 있는"
  },
  {
    "segment_id": "s-00094",
    "start_seconds": 170,
    "end_seconds": 172,
    "text": "몇 가지 방향을 보여 드릴 수"
  },
  {
    "segment_id": "s-00095",
    "start_seconds": 172,
    "end_seconds": 173,
    "text": "있으며, 미래에 우리가 도달"
  },
  {
    "segment_id": "s-00096",
    "start_seconds": 173,
    "end_seconds": 175,
    "text": "할 곳을 보며 여러분도"
  },
  {
    "segment_id": "s-00097",
    "start_seconds": 175,
    "end_seconds": 176,
    "text": "기대해 주시길 바랍니다."
  },
  {
    "segment_id": "s-00098",
    "start_seconds": 176,
    "end_seconds": 178,
    "text": "좋습니다. 에이전트 호스트"
  },
  {
    "segment_id": "s-00099",
    "start_seconds": 178,
    "end_seconds": 179,
    "text": "프로토콜 (AHP) 을 실제로 보여"
  },
  {
    "segment_id": "s-00100",
    "start_seconds": 179,
    "end_seconds": 181,
    "text": "드리기 위해, 개발자들 사이"
  },
  {
    "segment_id": "s-00101",
    "start_seconds": 181,
    "end_seconds": 182,
    "text": "에서 매우 흔히 사용 되는"
  },
  {
    "segment_id": "s-00102",
    "start_seconds": 182,
    "end_seconds": 183,
    "text": "것을 하나 활용 해"
  },
  {
    "segment_id": "s-00103",
    "start_seconds": 183,
    "end_seconds": 184,
    "text": "보겠습니다. 아마 많은 분이"
  },
  {
    "segment_id": "s-00104",
    "start_seconds": 184,
    "end_seconds": 186,
    "text": "각자의 소규모 개인 Tailscale"
  },
  {
    "segment_id": "s-00105",
    "start_seconds": 186,
    "end_seconds": 187,
    "text": "네트워크를 가지고 계실"
  },
  {
    "segment_id": "s-00106",
    "start_seconds": 187,
    "end_seconds": 189,
    "text": "겁니다. 저 역시 집에서 Mac,"
  },
  {
    "segment_id": "s-00107",
    "start_seconds": 189,
    "end_seconds": 191,
    "text": "Windows, Linux 머신을 항상 구동"
  },
  {
    "segment_id": "s-00108",
    "start_seconds": 191,
    "end_seconds": 193,
    "text": "하고 있죠. 각 머신은 Copilot"
  },
  {
    "segment_id": "s-00109",
    "start_seconds": 193,
    "end_seconds": 194,
    "text": "에이전트 뿐만 아니라 다른"
  },
  {
    "segment_id": "s-00110",
    "start_seconds": 194,
    "end_seconds": 196,
    "text": "에이전트들도 실행 하고"
  },
  {
    "segment_id": "s-00111",
    "start_seconds": 196,
    "end_seconds": 197,
    "text": "있습니다. 하지만 그 머신들"
  },
  {
    "segment_id": "s-00112",
    "start_seconds": 197,
    "end_seconds": 199,
    "text": "에 접근 하려면 반드시"
  },
  {
    "segment_id": "s-00113",
    "start_seconds": 199,
    "end_seconds": 200,
    "text": "Tailscale 네트워크에 연결된"
  },
  {
    "segment_id": "s-00114",
    "start_seconds": 200,
    "end_seconds": 202,
    "text": "기기가 있어야 한다는 제약이"
  },
  {
    "segment_id": "s-00115",
    "start_seconds": 202,
    "end_seconds": 203,
    "text": "항상 따릅니다. 우리는"
  },
  {
    "segment_id": "s-00116",
    "start_seconds": 203,
    "end_seconds": 205,
    "text": "새로운 세상에서 이러한 제약"
  },
  {
    "segment_id": "s-00117",
    "start_seconds": 205,
    "end_seconds": 206,
    "text": "마저 완전히 벗어날 수 있는"
  },
  {
    "segment_id": "s-00118",
    "start_seconds": 206,
    "end_seconds": 208,
    "text": "발판을 마련 하고자 합니다."
  },
  {
    "segment_id": "s-00119",
    "start_seconds": 208,
    "end_seconds": 210,
    "text": "그래서 먼저 제가 할 일은 제"
  },
  {
    "segment_id": "s-00120",
    "start_seconds": 210,
    "end_seconds": 212,
    "text": "홈 NAS에 로그인 하는 것"
  },
  {
    "segment_id": "s-00121",
    "start_seconds": 212,
    "end_seconds": 215,
    "text": "입니다. 이제는 누구나 집에"
  },
  {
    "segment_id": "s-00122",
    "start_seconds": 215,
    "end_seconds": 217,
    "text": "80TB NAS를 두게 될 것 같지만,"
  },
  {
    "segment_id": "s-00123",
    "start_seconds": 217,
    "end_seconds": 219,
    "text": "이건 제가 대용량 파일을"
  },
  {
    "segment_id": "s-00124",
    "start_seconds": 219,
    "end_seconds": 221,
    "text": "호스팅 하고 가족 들이 보관"
  },
  {
    "segment_id": "s-00125",
    "start_seconds": 221,
    "end_seconds": 223,
    "text": "하고 싶어 하는 자료 들을"
  },
  {
    "segment_id": "s-00126",
    "start_seconds": 223,
    "end_seconds": 225,
    "text": "아카이브 하며 코딩 작업도"
  },
  {
    "segment_id": "s-00127",
    "start_seconds": 225,
    "end_seconds": 228,
    "text": "수행 하는 개인용 NAS 입니다."
  },
  {
    "segment_id": "s-00128",
    "start_seconds": 228,
    "end_seconds": 230,
    "text": "AHP는 다양한 클라이언트를"
  },
  {
    "segment_id": "s-00129",
    "start_seconds": 230,
    "end_seconds": 232,
    "text": "지원 합니다. 우리는 다른"
  },
  {
    "segment_id": "s-00130",
    "start_seconds": 232,
    "end_seconds": 234,
    "text": "환경으로 기능을 확장 하기"
  },
  {
    "segment_id": "s-00131",
    "start_seconds": 234,
    "end_seconds": 235,
    "text": "위한 레퍼런스 구현체로"
  },
  {
    "segment_id": "s-00132",
    "start_seconds": 235,
    "end_seconds": 237,
    "text": "내부적으로 하나를 개발"
  },
  {
    "segment_id": "s-00133",
    "start_seconds": 237,
    "end_seconds": 238,
    "text": "했습니다. 직접 호스트를"
  },
  {
    "segment_id": "s-00134",
    "start_seconds": 238,
    "end_seconds": 240,
    "text": "다루는 방법은 잠시 후에"
  },
  {
    "segment_id": "s-00135",
    "start_seconds": 240,
    "end_seconds": 242,
    "text": "말씀 드리기로 하고, 지금은 '"
  },
  {
    "segment_id": "s-00136",
    "start_seconds": 242,
    "end_seconds": 243,
    "text": "Copilot D' 라고 부르는 것을"
  },
  {
    "segment_id": "s-00137",
    "start_seconds": 243,
    "end_seconds": 245,
    "text": "사용 하겠습니다. Copilot D를"
  },
  {
    "segment_id": "s-00138",
    "start_seconds": 245,
    "end_seconds": 246,
    "text": "사용 하면 어떤 호스트"
  },
  {
    "segment_id": "s-00139",
    "start_seconds": 246,
    "end_seconds": 248,
    "text": "에서든 서비스를 즉시 실행할"
  },
  {
    "segment_id": "s-00140",
    "start_seconds": 248,
    "end_seconds": 250,
    "text": "수 있습니다. 보시 다시피이"
  },
  {
    "segment_id": "s-00141",
    "start_seconds": 250,
    "end_seconds": 252,
    "text": "인수를 통해 릴레이를 열 수"
  },
  {
    "segment_id": "s-00142",
    "start_seconds": 252,
    "end_seconds": 254,
    "text": "있습니다. 환경 이름을 쉽게"
  },
  {
    "segment_id": "s-00143",
    "start_seconds": 254,
    "end_seconds": 256,
    "text": "정의 할 수도 있고요. 여기는"
  },
  {
    "segment_id": "s-00144",
    "start_seconds": 256,
    "end_seconds": 258,
    "text": "제 홈 Linux 머신 입니다. 워크"
  },
  {
    "segment_id": "s-00145",
    "start_seconds": 258,
    "end_seconds": 259,
    "text": "스페이스 폴더가 있습니다."
  },
  {
    "segment_id": "s-00146",
    "start_seconds": 259,
    "end_seconds": 261,
    "text": "호스트를 실행할 때, 기본적"
  },
  {
    "segment_id": "s-00147",
    "start_seconds": 261,
    "end_seconds": 262,
    "text": "으로 어떤 현재 작업"
  },
  {
    "segment_id": "s-00148",
    "start_seconds": 262,
    "end_seconds": 264,
    "text": "디렉토리에 제한을 둘지 설정"
  },
  {
    "segment_id": "s-00149",
    "start_seconds": 264,
    "end_seconds": 265,
    "text": "하는 것 입니다. 원하신다 면"
  },
  {
    "segment_id": "s-00150",
    "start_seconds": 265,
    "end_seconds": 266,
    "text": "하나 이상을 설정할 수도"
  },
  {
    "segment_id": "s-00151",
    "start_seconds": 266,
    "end_seconds": 268,
    "text": "있습니다. 마지막으로 어떤"
  },
  {
    "segment_id": "s-00152",
    "start_seconds": 268,
    "end_seconds": 269,
    "text": "포트로 노출 할지, 그리고"
  },
  {
    "segment_id": "s-00153",
    "start_seconds": 269,
    "end_seconds": 270,
    "text": "기본 로그 출력 수준을"
  },
  {
    "segment_id": "s-00154",
    "start_seconds": 270,
    "end_seconds": 272,
    "text": "어떻게 할지 결정 합니다."
  },
  {
    "segment_id": "s-00155",
    "start_seconds": 272,
    "end_seconds": 274,
    "text": "호스트가 자체적으로 실행"
  },
  {
    "segment_id": "s-00156",
    "start_seconds": 274,
    "end_seconds": 275,
    "text": "되는 것을 보면, 환경 식별자"
  },
  {
    "segment_id": "s-00157",
    "start_seconds": 275,
    "end_seconds": 277,
    "text": "가 생성 되는 것을 확인 하실"
  },
  {
    "segment_id": "s-00158",
    "start_seconds": 277,
    "end_seconds": 280,
    "text": "수 있습니다. 우선 그 값을"
  },
  {
    "segment_id": "s-00159",
    "start_seconds": 280,
    "end_seconds": 281,
    "text": "복사 해 두겠습니다."
  },
  {
    "segment_id": "s-00160",
    "start_seconds": 281,
    "end_seconds": 283,
    "text": "앞으로는 더 사용 하기 쉽고"
  },
  {
    "segment_id": "s-00161",
    "start_seconds": 283,
    "end_seconds": 284,
    "text": "편리 하게 개선 할 예정"
  },
  {
    "segment_id": "s-00162",
    "start_seconds": 284,
    "end_seconds": 286,
    "text": "이지만, 현재 로서는 환경 ID"
  },
  {
    "segment_id": "s-00163",
    "start_seconds": 286,
    "end_seconds": 288,
    "text": "만 있으면 충분 합니다. 이제"
  },
  {
    "segment_id": "s-00164",
    "start_seconds": 288,
    "end_seconds": 289,
    "text": "이 머신에서 호스트가 실행"
  },
  {
    "segment_id": "s-00165",
    "start_seconds": 289,
    "end_seconds": 293,
    "text": "되고 있습니다. 그 자체로는"
  },
  {
    "segment_id": "s-00166",
    "start_seconds": 293,
    "end_seconds": 295,
    "text": "큰 의미가 없지만, 여기이 탭"
  },
  {
    "segment_id": "s-00167",
    "start_seconds": 295,
    "end_seconds": 297,
    "text": "에 있는 제 로컬 머신으로"
  },
  {
    "segment_id": "s-00168",
    "start_seconds": 297,
    "end_seconds": 299,
    "text": "돌아와서, 여러분 모두에게"
  },
  {
    "segment_id": "s-00169",
    "start_seconds": 299,
    "end_seconds": 301,
    "text": "익숙 하실 Copilot CLI를 바로"
  },
  {
    "segment_id": "s-00170",
    "start_seconds": 301,
    "end_seconds": 305,
    "text": "실행할 수 있습니다. 자, 한번"
  },
  {
    "segment_id": "s-00171",
    "start_seconds": 305,
    "end_seconds": 308,
    "text": "켜 보겠습니다. 다음으로"
  },
  {
    "segment_id": "s-00172",
    "start_seconds": 308,
    "end_seconds": 310,
    "text": "다가올 빌드 내부 에는 ahp"
  },
  {
    "segment_id": "s-00173",
    "start_seconds": 310,
    "end_seconds": 313,
    "text": "명령어가 있습니다. 이"
  },
  {
    "segment_id": "s-00174",
    "start_seconds": 313,
    "end_seconds": 314,
    "text": "명령어를 통해 호스트에"
  },
  {
    "segment_id": "s-00175",
    "start_seconds": 314,
    "end_seconds": 316,
    "text": "연결할 수 있습니다. 또한"
  },
  {
    "segment_id": "s-00176",
    "start_seconds": 316,
    "end_seconds": 317,
    "text": "호스트 간의 세션을 확인"
  },
  {
    "segment_id": "s-00177",
    "start_seconds": 317,
    "end_seconds": 319,
    "text": "하고 재시작 할 수도"
  },
  {
    "segment_id": "s-00178",
    "start_seconds": 319,
    "end_seconds": 321,
    "text": "있습니다. 이와 관련된 몇"
  },
  {
    "segment_id": "s-00179",
    "start_seconds": 321,
    "end_seconds": 322,
    "text": "가지 흥미로운 기능이 더"
  },
  {
    "segment_id": "s-00180",
    "start_seconds": 322,
    "end_seconds": 324,
    "text": "있지만, 우선 핵심 적인 ahp"
  },
  {
    "segment_id": "s-00181",
    "start_seconds": 324,
    "end_seconds": 326,
    "text": "개념을 보여 드리기 위해"
  },
  {
    "segment_id": "s-00182",
    "start_seconds": 326,
    "end_seconds": 328,
    "text": "호스트 명령어부터 설명"
  },
  {
    "segment_id": "s-00183",
    "start_seconds": 328,
    "end_seconds": 330,
    "text": "하겠습니다. 현재 저희는"
  },
  {
    "segment_id": "s-00184",
    "start_seconds": 330,
    "end_seconds": 331,
    "text": "어떤 호스트 에도 연결 되어"
  },
  {
    "segment_id": "s-00185",
    "start_seconds": 331,
    "end_seconds": 333,
    "text": "있지 않습니다. Copilot CLI가"
  },
  {
    "segment_id": "s-00186",
    "start_seconds": 333,
    "end_seconds": 335,
    "text": "아직 연결 되도록 구성 되지"
  },
  {
    "segment_id": "s-00187",
    "start_seconds": 335,
    "end_seconds": 338,
    "text": "않았기 때문 입니다. 하지만"
  },
  {
    "segment_id": "s-00188",
    "start_seconds": 338,
    "end_seconds": 340,
    "text": "AHP 클라우드 명령어를 실행"
  },
  {
    "segment_id": "s-00189",
    "start_seconds": 340,
    "end_seconds": 342,
    "text": "하고 환경 변수를 입력 하면,"
  },
  {
    "segment_id": "s-00190",
    "start_seconds": 342,
    "end_seconds": 344,
    "text": "AHP 탭으로 돌아 갔을 때 연결"
  },
  {
    "segment_id": "s-00191",
    "start_seconds": 344,
    "end_seconds": 346,
    "text": "이 생성 되는 것을 확인할 수"
  },
  {
    "segment_id": "s-00192",
    "start_seconds": 346,
    "end_seconds": 353,
    "text": "있을 겁니다. 좋은 점은 이제"
  },
  {
    "segment_id": "s-00193",
    "start_seconds": 353,
    "end_seconds": 355,
    "text": "제 로컬 Copilot CLI 인스턴스를"
  },
  {
    "segment_id": "s-00194",
    "start_seconds": 355,
    "end_seconds": 357,
    "text": "클라우드를 거쳐 집에 있는"
  },
  {
    "segment_id": "s-00195",
    "start_seconds": 357,
    "end_seconds": 358,
    "text": "제 리눅스 머신과 연결"
  },
  {
    "segment_id": "s-00196",
    "start_seconds": 358,
    "end_seconds": 363,
    "text": "했다는 것 입니다. 이제 AHP"
  },
  {
    "segment_id": "s-00197",
    "start_seconds": 363,
    "end_seconds": 365,
    "text": "호스트 명령어를 다시 실행"
  },
  {
    "segment_id": "s-00198",
    "start_seconds": 365,
    "end_seconds": 367,
    "text": "해 보겠습니다. CopilotD를 통해"
  },
  {
    "segment_id": "s-00199",
    "start_seconds": 367,
    "end_seconds": 369,
    "text": "외부로 연결된 것을 확인할"
  },
  {
    "segment_id": "s-00200",
    "start_seconds": 369,
    "end_seconds": 371,
    "text": "수 있습니다. 프로토콜 버전,"
  },
  {
    "segment_id": "s-00201",
    "start_seconds": 371,
    "end_seconds": 374,
    "text": "환경 ID 등을 확인할 수 있죠."
  },
  {
    "segment_id": "s-00202",
    "start_seconds": 374,
    "end_seconds": 376,
    "text": "이는 제가 로컬에서 Copilot을"
  },
  {
    "segment_id": "s-00203",
    "start_seconds": 376,
    "end_seconds": 378,
    "text": "실행할 수 있을 뿐만 아니라,"
  },
  {
    "segment_id": "s-00204",
    "start_seconds": 378,
    "end_seconds": 379,
    "text": "제 머신을 통해 외부의 홈"
  },
  {
    "segment_id": "s-00205",
    "start_seconds": 379,
    "end_seconds": 381,
    "text": "머신과도 연결 되었음을 보여"
  },
  {
    "segment_id": "s-00206",
    "start_seconds": 381,
    "end_seconds": 384,
    "text": "줍니다. 대신 해당 머신을"
  },
  {
    "segment_id": "s-00207",
    "start_seconds": 384,
    "end_seconds": 387,
    "text": "사용 하고 싶다면, 단순히/AHP"
  },
  {
    "segment_id": "s-00208",
    "start_seconds": 387,
    "end_seconds": 388,
    "text": "use 명령어를 실행 하면"
  },
  {
    "segment_id": "s-00209",
    "start_seconds": 388,
    "end_seconds": 391,
    "text": "됩니다. 이를 통해 해당 머신"
  },
  {
    "segment_id": "s-00210",
    "start_seconds": 391,
    "end_seconds": 393,
    "text": "에 직접 연결할 수 있습니다."
  },
  {
    "segment_id": "s-00211",
    "start_seconds": 393,
    "end_seconds": 395,
    "text": "기본적으로 새로운 세션을"
  },
  {
    "segment_id": "s-00212",
    "start_seconds": 395,
    "end_seconds": 397,
    "text": "생성 할 수 있게 됩니다. 또한"
  },
  {
    "segment_id": "s-00213",
    "start_seconds": 397,
    "end_seconds": 399,
    "text": "연결 (attach) 기능도 사용할 수"
  },
  {
    "segment_id": "s-00214",
    "start_seconds": 399,
    "end_seconds": 401,
    "text": "있는데, 잠시 후에 그 유연한"
  },
  {
    "segment_id": "s-00215",
    "start_seconds": 401,
    "end_seconds": 402,
    "text": "기능을 보여 드리겠습니다."
  },
  {
    "segment_id": "s-00216",
    "start_seconds": 402,
    "end_seconds": 404,
    "text": "좋습니다, 새 세션을 시작"
  },
  {
    "segment_id": "s-00217",
    "start_seconds": 404,
    "end_seconds": 407,
    "text": "하려면/AHP new를 입력 하기만"
  },
  {
    "segment_id": "s-00218",
    "start_seconds": 407,
    "end_seconds": 410,
    "text": "하면 됩니다. 그러면 제"
  },
  {
    "segment_id": "s-00219",
    "start_seconds": 410,
    "end_seconds": 412,
    "text": "인터페이스가 업데이트 되어"
  },
  {
    "segment_id": "s-00220",
    "start_seconds": 412,
    "end_seconds": 413,
    "text": "원격 호스트를 반영 하게"
  },
  {
    "segment_id": "s-00221",
    "start_seconds": 413,
    "end_seconds": 416,
    "text": "됩니다. 앞서 워크 스페이스"
  },
  {
    "segment_id": "s-00222",
    "start_seconds": 416,
    "end_seconds": 418,
    "text": "폴더 경로에서 보여 드린"
  },
  {
    "segment_id": "s-00223",
    "start_seconds": 418,
    "end_seconds": 420,
    "text": "것과 마찬가지로, 이것은 더"
  },
  {
    "segment_id": "s-00224",
    "start_seconds": 420,
    "end_seconds": 421,
    "text": "이상 제 로컬 머신에 있는"
  },
  {
    "segment_id": "s-00225",
    "start_seconds": 421,
    "end_seconds": 423,
    "text": "디렉토리가 아닙니다. 사실"
  },
  {
    "segment_id": "s-00226",
    "start_seconds": 423,
    "end_seconds": 425,
    "text": "이것은 집에 있는 로컬"
  },
  {
    "segment_id": "s-00227",
    "start_seconds": 425,
    "end_seconds": 427,
    "text": "리눅스 서버에서 가동 중인"
  },
  {
    "segment_id": "s-00228",
    "start_seconds": 427,
    "end_seconds": 429,
    "text": "런타임 입니다. AHP 호스트를"
  },
  {
    "segment_id": "s-00229",
    "start_seconds": 429,
    "end_seconds": 430,
    "text": "직접 실행 중인 워크"
  },
  {
    "segment_id": "s-00230",
    "start_seconds": 430,
    "end_seconds": 432,
    "text": "스페이스 폴더로 현재 작업"
  },
  {
    "segment_id": "s-00231",
    "start_seconds": 432,
    "end_seconds": 434,
    "text": "디렉토리가 설정 되어 있고,"
  },
  {
    "segment_id": "s-00232",
    "start_seconds": 434,
    "end_seconds": 436,
    "text": "해당 머신의 에이전트와 바로"
  },
  {
    "segment_id": "s-00233",
    "start_seconds": 436,
    "end_seconds": 443,
    "text": "상호 작용할 수 있습니다. 이"
  },
  {
    "segment_id": "s-00234",
    "start_seconds": 443,
    "end_seconds": 445,
    "text": "방식의 큰 장점 중 하나는"
  },
  {
    "segment_id": "s-00235",
    "start_seconds": 445,
    "end_seconds": 447,
    "text": "런타임이 다른 곳에서 실행"
  },
  {
    "segment_id": "s-00236",
    "start_seconds": 447,
    "end_seconds": 449,
    "text": "중이라도 CLI, VS Code, GitHub"
  },
  {
    "segment_id": "s-00237",
    "start_seconds": 449,
    "end_seconds": 450,
    "text": "Copilot 앱 또는 프로토콜을"
  },
  {
    "segment_id": "s-00238",
    "start_seconds": 450,
    "end_seconds": 453,
    "text": "따르는 어떤 클라이언트 든이"
  },
  {
    "segment_id": "s-00239",
    "start_seconds": 453,
    "end_seconds": 454,
    "text": "인터페이스에 접속 하여"
  },
  {
    "segment_id": "s-00240",
    "start_seconds": 454,
    "end_seconds": 456,
    "text": "에이전트 세션을 제어 할 수"
  },
  {
    "segment_id": "s-00241",
    "start_seconds": 456,
    "end_seconds": 462,
    "text": "있다는 점 입니다. 하지만"
  },
  {
    "segment_id": "s-00242",
    "start_seconds": 462,
    "end_seconds": 467,
    "text": "여기서 끝이 아닙니다. 원격"
  },
  {
    "segment_id": "s-00243",
    "start_seconds": 467,
    "end_seconds": 469,
    "text": "기술에 아주 유용한 추가"
  },
  {
    "segment_id": "s-00244",
    "start_seconds": 469,
    "end_seconds": 470,
    "text": "기능으로, 여러 세션을"
  },
  {
    "segment_id": "s-00245",
    "start_seconds": 470,
    "end_seconds": 472,
    "text": "동시에 연결할 수 있는"
  },
  {
    "segment_id": "s-00246",
    "start_seconds": 472,
    "end_seconds": 478,
    "text": "독특한 기능이 있습니다. 이"
  },
  {
    "segment_id": "s-00247",
    "start_seconds": 478,
    "end_seconds": 480,
    "text": "클라이언트 에도 AHP 호스트를"
  },
  {
    "segment_id": "s-00248",
    "start_seconds": 480,
    "end_seconds": 482,
    "text": "추가 하고, 다른 명령어를"
  },
  {
    "segment_id": "s-00249",
    "start_seconds": 482,
    "end_seconds": 484,
    "text": "실행 해서 세션 목록을"
  },
  {
    "segment_id": "s-00250",
    "start_seconds": 484,
    "end_seconds": 488,
    "text": "확인해 보겠습니다. 앗. 네,"
  },
  {
    "segment_id": "s-00251",
    "start_seconds": 488,
    "end_seconds": 494,
    "text": "여기 있습니다. 앗. 끝에 'ls'"
  },
  {
    "segment_id": "s-00252",
    "start_seconds": 494,
    "end_seconds": 496,
    "text": "를 붙이는 게 좋겠네요. E39"
  },
  {
    "segment_id": "s-00253",
    "start_seconds": 496,
    "end_seconds": 498,
    "text": "라는 활성 세션이 있는 것을"
  },
  {
    "segment_id": "s-00254",
    "start_seconds": 498,
    "end_seconds": 500,
    "text": "확인할 수 있습니다. 제"
  },
  {
    "segment_id": "s-00255",
    "start_seconds": 500,
    "end_seconds": 502,
    "text": "프롬프트와 일치 하는 OnePlus"
  },
  {
    "segment_id": "s-00256",
    "start_seconds": 502,
    "end_seconds": 504,
    "text": "One이 보이는데, 이는 해당"
  },
  {
    "segment_id": "s-00257",
    "start_seconds": 504,
    "end_seconds": 506,
    "text": "세션에 직접 연결할 수"
  },
  {
    "segment_id": "s-00258",
    "start_seconds": 506,
    "end_seconds": 509,
    "text": "있다는 뜻 입니다. HP attach를"
  },
  {
    "segment_id": "s-00259",
    "start_seconds": 509,
    "end_seconds": 511,
    "text": "사용 해서 여기 있는 식별자"
  },
  {
    "segment_id": "s-00260",
    "start_seconds": 511,
    "end_seconds": 515,
    "text": "를 복사 해 보겠습니다. 이제"
  },
  {
    "segment_id": "s-00261",
    "start_seconds": 515,
    "end_seconds": 517,
    "text": "세션을 서로 연결할 수 있을"
  },
  {
    "segment_id": "s-00262",
    "start_seconds": 517,
    "end_seconds": 518,
    "text": "겁니다. 저희 원격 기술을"
  },
  {
    "segment_id": "s-00263",
    "start_seconds": 518,
    "end_seconds": 520,
    "text": "사용해 보셨다면 아시겠지만,"
  },
  {
    "segment_id": "s-00264",
    "start_seconds": 520,
    "end_seconds": 522,
    "text": "기존 에는 풀 (pull) 기반 방식"
  },
  {
    "segment_id": "s-00265",
    "start_seconds": 522,
    "end_seconds": 524,
    "text": "이었습니다. 기존 에는 세션"
  },
  {
    "segment_id": "s-00266",
    "start_seconds": 524,
    "end_seconds": 525,
    "text": "을 제어 할 수 있는 활성"
  },
  {
    "segment_id": "s-00267",
    "start_seconds": 525,
    "end_seconds": 527,
    "text": "클라이언트가 하나만 가능"
  },
  {
    "segment_id": "s-00268",
    "start_seconds": 527,
    "end_seconds": 529,
    "text": "하도록 제한 되어 있었습니다"
  },
  {
    "segment_id": "s-00269",
    "start_seconds": 529,
    "end_seconds": 531,
    "text": ". 이제 실시간 재현 기능과"
  },
  {
    "segment_id": "s-00270",
    "start_seconds": 531,
    "end_seconds": 533,
    "text": "관련 하여 더 발전된 기능을"
  },
  {
    "segment_id": "s-00271",
    "start_seconds": 533,
    "end_seconds": 536,
    "text": "사용할 수 있습니다. 재생"
  },
  {
    "segment_id": "s-00272",
    "start_seconds": 536,
    "end_seconds": 537,
    "text": "시스템과 클라이언트 간의"
  },
  {
    "segment_id": "s-00273",
    "start_seconds": 537,
    "end_seconds": 539,
    "text": "세션 이식성과 관련 해서도"
  },
  {
    "segment_id": "s-00274",
    "start_seconds": 539,
    "end_seconds": 541,
    "text": "향상된 기능을 제공 합니다."
  },
  {
    "segment_id": "s-00275",
    "start_seconds": 541,
    "end_seconds": 543,
    "text": "결과적으로 클라이언트 간에"
  },
  {
    "segment_id": "s-00276",
    "start_seconds": 543,
    "end_seconds": 545,
    "text": "실시간 업데이트를 바로"
  },
  {
    "segment_id": "s-00277",
    "start_seconds": 545,
    "end_seconds": 546,
    "text": "확인할 수 있게 됩니다. 보시"
  },
  {
    "segment_id": "s-00278",
    "start_seconds": 546,
    "end_seconds": 548,
    "text": "다시피 한 클라이언트에 3 + 3"
  },
  {
    "segment_id": "s-00279",
    "start_seconds": 548,
    "end_seconds": 550,
    "text": "을 입력 했습니다. 엔터를"
  },
  {
    "segment_id": "s-00280",
    "start_seconds": 550,
    "end_seconds": 551,
    "text": "누르는 즉시 다른 클라이언트"
  },
  {
    "segment_id": "s-00281",
    "start_seconds": 551,
    "end_seconds": 552,
    "text": "에서도 바로 확인할 수"
  },
  {
    "segment_id": "s-00282",
    "start_seconds": 552,
    "end_seconds": 553,
    "text": "있습니다. 양쪽 모두에서"
  },
  {
    "segment_id": "s-00283",
    "start_seconds": 553,
    "end_seconds": 555,
    "text": "응답을 볼 수 있죠. 저희의"
  },
  {
    "segment_id": "s-00284",
    "start_seconds": 555,
    "end_seconds": 556,
    "text": "핵심 목표는 새로운"
  },
  {
    "segment_id": "s-00285",
    "start_seconds": 556,
    "end_seconds": 558,
    "text": "클라이언트를 연결 하거나"
  },
  {
    "segment_id": "s-00286",
    "start_seconds": 558,
    "end_seconds": 560,
    "text": "해제 하더라도 각 클라이언트"
  },
  {
    "segment_id": "s-00287",
    "start_seconds": 560,
    "end_seconds": 562,
    "text": "가 활성 드라이버 로서 세션"
  },
  {
    "segment_id": "s-00288",
    "start_seconds": 562,
    "end_seconds": 563,
    "text": "에 참여할 수 있도록 하는 것"
  },
  {
    "segment_id": "s-00289",
    "start_seconds": 563,
    "end_seconds": 565,
    "text": "입니다. 이렇게 하면 노트북"
  },
  {
    "segment_id": "s-00290",
    "start_seconds": 565,
    "end_seconds": 567,
    "text": "에서 폰으로, 폰에서 다시"
  },
  {
    "segment_id": "s-00291",
    "start_seconds": 567,
    "end_seconds": 568,
    "text": "노트북으로, 업무용 기기에서"
  },
  {
    "segment_id": "s-00292",
    "start_seconds": 568,
    "end_seconds": 570,
    "text": "개인용 기기로 작업 환경에"
  },
  {
    "segment_id": "s-00293",
    "start_seconds": 570,
    "end_seconds": 572,
    "text": "따라 자유롭게 전환 할 수"
  },
  {
    "segment_id": "s-00294",
    "start_seconds": 572,
    "end_seconds": 573,
    "text": "있으며, 이 모든 기능은"
  },
  {
    "segment_id": "s-00295",
    "start_seconds": 573,
    "end_seconds": 575,
    "text": "새로운 HP 프로토콜을 통해"
  },
  {
    "segment_id": "s-00296",
    "start_seconds": 575,
    "end_seconds": 576,
    "text": "제공 됩니다. 다시 말씀"
  },
  {
    "segment_id": "s-00297",
    "start_seconds": 576,
    "end_seconds": 578,
    "text": "드리지만, 저희는이 프로토콜"
  },
  {
    "segment_id": "s-00298",
    "start_seconds": 578,
    "end_seconds": 579,
    "text": "을 서비스에 내장 하고"
  },
  {
    "segment_id": "s-00299",
    "start_seconds": 579,
    "end_seconds": 581,
    "text": "있으며, 공개적으로 공유"
  },
  {
    "segment_id": "s-00300",
    "start_seconds": 581,
    "end_seconds": 582,
    "text": "하여 기능을 개선 하고"
  },
  {
    "segment_id": "s-00301",
    "start_seconds": 582,
    "end_seconds": 584,
    "text": "런타임 지원을 확대 할 방법"
  },
  {
    "segment_id": "s-00302",
    "start_seconds": 584,
    "end_seconds": 586,
    "text": "을 계속 모색 하고 있습니다."
  },
  {
    "segment_id": "s-00303",
    "start_seconds": 586,
    "end_seconds": 588,
    "text": "이것이 궁극적으로 github.com"
  },
  {
    "segment_id": "s-00304",
    "start_seconds": 588,
    "end_seconds": 590,
    "text": "경험으로 어떻게 이어질지"
  },
  {
    "segment_id": "s-00305",
    "start_seconds": 590,
    "end_seconds": 592,
    "text": "생각해 보면, 개인적으로"
  },
  {
    "segment_id": "s-00306",
    "start_seconds": 592,
    "end_seconds": 594,
    "text": "가장 흥미로운 점은 미션"
  },
  {
    "segment_id": "s-00307",
    "start_seconds": 594,
    "end_seconds": 595,
    "text": "컨트롤 (Mission Control) 과의"
  },
  {
    "segment_id": "s-00308",
    "start_seconds": 595,
    "end_seconds": 599,
    "text": "통합 입니다. 저희 CopilotD"
  },
  {
    "segment_id": "s-00309",
    "start_seconds": 599,
    "end_seconds": 601,
    "text": "서비스는 런타임에 직접 기능"
  },
  {
    "segment_id": "s-00310",
    "start_seconds": 601,
    "end_seconds": 603,
    "text": "을 구현 하고자 하며, 미션"
  },
  {
    "segment_id": "s-00311",
    "start_seconds": 603,
    "end_seconds": 605,
    "text": "컨트롤에서 원격 실행 환경을"
  },
  {
    "segment_id": "s-00312",
    "start_seconds": 605,
    "end_seconds": 607,
    "text": "바로 제어 할 수 있게"
  },
  {
    "segment_id": "s-00313",
    "start_seconds": 607,
    "end_seconds": 610,
    "text": "해줍니다. IDE, CLI, 모바일에"
  },
  {
    "segment_id": "s-00314",
    "start_seconds": 610,
    "end_seconds": 613,
    "text": "이어 이제 웹에 대해 이야기"
  },
  {
    "segment_id": "s-00315",
    "start_seconds": 613,
    "end_seconds": 615,
    "text": "해 보겠습니다. 참고로, 미션"
  },
  {
    "segment_id": "s-00316",
    "start_seconds": 615,
    "end_seconds": 618,
    "text": "컨트롤은 github.com/copilot/agents"
  },
  {
    "segment_id": "s-00317",
    "start_seconds": 618,
    "end_seconds": 621,
    "text": "에서 확인 하실 수 있습니다."
  },
  {
    "segment_id": "s-00318",
    "start_seconds": 621,
    "end_seconds": 623,
    "text": "메인 홈 화면을 보시면, 화면"
  },
  {
    "segment_id": "s-00319",
    "start_seconds": 623,
    "end_seconds": 624,
    "text": "에서 작업을 실행 하는"
  },
  {
    "segment_id": "s-00320",
    "start_seconds": 624,
    "end_seconds": 626,
    "text": "대부분의 사용자에게 익숙 할"
  },
  {
    "segment_id": "s-00321",
    "start_seconds": 626,
    "end_seconds": 630,
    "text": "몇 가지 옵션이 있습니다."
  },
  {
    "segment_id": "s-00322",
    "start_seconds": 630,
    "end_seconds": 632,
    "text": "하지만 AHP에서 가장 흥미로운"
  },
  {
    "segment_id": "s-00323",
    "start_seconds": 632,
    "end_seconds": 634,
    "text": "점은, 이제 커스텀 드롭 다운"
  },
  {
    "segment_id": "s-00324",
    "start_seconds": 634,
    "end_seconds": 636,
    "text": "메뉴로 환경을 불러와 로컬"
  },
  {
    "segment_id": "s-00325",
    "start_seconds": 636,
    "end_seconds": 638,
    "text": "기기 나 클라우드 등 올바른"
  },
  {
    "segment_id": "s-00326",
    "start_seconds": 638,
    "end_seconds": 640,
    "text": "AHP 호스트가 실행 되는 곳"
  },
  {
    "segment_id": "s-00327",
    "start_seconds": 640,
    "end_seconds": 641,
    "text": "이라면 어디 서든 새로운"
  },
  {
    "segment_id": "s-00328",
    "start_seconds": 641,
    "end_seconds": 643,
    "text": "세션을 실행 하고 미션"
  },
  {
    "segment_id": "s-00329",
    "start_seconds": 643,
    "end_seconds": 645,
    "text": "컨트롤에 연결할 수 있다는"
  },
  {
    "segment_id": "s-00330",
    "start_seconds": 645,
    "end_seconds": 647,
    "text": "것 입니다. 이제 새로운 환경"
  },
  {
    "segment_id": "s-00331",
    "start_seconds": 647,
    "end_seconds": 649,
    "text": "에서 실행할 수 있게 된"
  },
  {
    "segment_id": "s-00332",
    "start_seconds": 649,
    "end_seconds": 650,
    "text": "것이죠. 따라서 액션 이나"
  },
  {
    "segment_id": "s-00333",
    "start_seconds": 650,
    "end_seconds": 652,
    "text": "원격 클라우드 환경 에서만"
  },
  {
    "segment_id": "s-00334",
    "start_seconds": 652,
    "end_seconds": 653,
    "text": "실행 해야 한다는 제약에서"
  },
  {
    "segment_id": "s-00335",
    "start_seconds": 653,
    "end_seconds": 655,
    "text": "벗어날 수 있습니다. 자신의"
  },
  {
    "segment_id": "s-00336",
    "start_seconds": 655,
    "end_seconds": 657,
    "text": "개인 컴퓨터 에서도 실행할"
  },
  {
    "segment_id": "s-00337",
    "start_seconds": 657,
    "end_seconds": 659,
    "text": "수 있어 에이전트 네트워크를"
  },
  {
    "segment_id": "s-00338",
    "start_seconds": 659,
    "end_seconds": 660,
    "text": "더 넓게 활용 하고, 현재 상황"
  },
  {
    "segment_id": "s-00339",
    "start_seconds": 660,
    "end_seconds": 662,
    "text": "에 맞춰 어디서 에이전트를"
  },
  {
    "segment_id": "s-00340",
    "start_seconds": 662,
    "end_seconds": 664,
    "text": "실행 하는 것이 가장 효율적"
  },
  {
    "segment_id": "s-00341",
    "start_seconds": 664,
    "end_seconds": 667,
    "text": "일지 결정할 수 있습니다. 자,"
  },
  {
    "segment_id": "s-00342",
    "start_seconds": 667,
    "end_seconds": 669,
    "text": "간단히 쿼리를 입력 하면 제"
  },
  {
    "segment_id": "s-00343",
    "start_seconds": 669,
    "end_seconds": 671,
    "text": "환경으로 라우팅 되어 결과가"
  },
  {
    "segment_id": "s-00344",
    "start_seconds": 671,
    "end_seconds": 672,
    "text": "전달 됩니다. 응답이 표시"
  },
  {
    "segment_id": "s-00345",
    "start_seconds": 672,
